generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
}
enum PatientType {
  CHILD
  ADULT
}
enum AppointmentStatus {
  NEW
  CONFIRMED
  CANCELLED
  COMPLETED
}

model AdminUser {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(STAFF)
  isDemo       Boolean  @default(false)
  createdAt    DateTime @default(now())
}

model Service {
  id           Int           @id @default(autoincrement())
  title        String
  description  String
  category     String
  sortOrder    Int           @default(0)
  isActive     Boolean       @default(true)
  appointments Appointment[]
}

model Appointment {
  id            Int               @id @default(autoincrement())
  refCode       String            @unique
  patientName   String
  phone         String
  patientType   PatientType
  age           Int
  preferredDate DateTime          @db.Date
  preferredSlot String
  serviceId     Int?
  service       Service?          @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  note          String?
  status        AppointmentStatus @default(NEW)
  staffNote     String?
  consentAt     DateTime
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([status, createdAt])
}

model Doctor {
  id              Int     @id @default(autoincrement())
  name            String
  role            String
  qualification   String
  experienceYears Int
  bio             String
  photoUrl        String?
  visitingDays    String?
  sortOrder       Int     @default(0)
  isActive        Boolean @default(true)
}

model Timing {
  id        Int     @id @default(autoincrement())
  weekday   Int     @unique // 0 = Sunday
  openTime  String?
  closeTime String?
  open2Time  String?
  close2Time String?
  isClosed  Boolean @default(false)
  note      String?
}

model TimingOverride {
  id        Int      @id @default(autoincrement())
  date      DateTime @unique @db.Date
  isClosed  Boolean  @default(true)
  openTime  String?
  closeTime String?
  reason    String
}

model Announcement {
  id       Int      @id @default(autoincrement())
  title    String
  body     String
  startsAt DateTime @default(now())
  endsAt   DateTime?
  isActive Boolean  @default(true)
}

model ClinicSetting {
  key   String @id
  value String
}
