{
  "name": "clinic-web",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "db:up": "docker compose up -d db",
    "db:migrate": "npm run migrate -w apps/api",
    "db:seed": "npm run seed -w apps/api",
    "db:deploy": "npm run deploy -w apps/api && npm run seed -w apps/api",
    "admin:create": "npm run admin:create -w apps/api --",
    "secret": "bash scripts/gen-jwt-secret.sh",
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web"
  }
}